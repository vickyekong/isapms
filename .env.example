DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Lagos
DJANGO_SECURE_SSL_REDIRECT=False

DB_NAME=isapms
DB_USER=isapms
DB_PASSWORD=change_me_local_only
DB_HOST=127.0.0.1
DB_PORT=3306
USE_SQLITE=false
# Hosted MySQL (e.g. Aiven) needs TLS: point DB_SSL_CA at the provider's CA file,
# or put the certificate text in DB_SSL_CA_PEM where files cannot be shipped (Vercel).
DB_SSL_CA=
DB_SSL_CA_PEM=

# Set when a Vercel Blob store is connected; trained models are then stored there.
BLOB_READ_WRITE_TOKEN=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@nexusstate.edu.ng

INSTITUTION_NAME=Nexus State University
INSTITUTION_SHORT_NAME=NSU
